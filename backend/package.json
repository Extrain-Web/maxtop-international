{
  "name": "maxtop-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Maxtop International — REST API (Express + MongoDB) for the website and admin dashboard",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "import-products": "node --env-file-if-exists=.env scripts/import-products.mjs",
    "snapshot": "node --env-file-if-exists=.env scripts/snapshot.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.2",
    "multer": "^2.5.0",
    "sharp": "^0.35.5"
  }
}
