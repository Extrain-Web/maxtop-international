# ── Maxtop backend (.env) ────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# MongoDB (local VPS mongo or MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/maxtop

# long random string — generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
SESSION_DAYS=7

# website address(es) that may call the API from the browser
ALLOWED_ORIGINS=https://maxtopinternational.com,https://www.maxtopinternational.com

# Next.js site on the same server — lets the API refresh the site right after an admin edit
FRONTEND_URL=http://127.0.0.1:3000
# must be the same value in the frontend .env
REVALIDATE_SECRET=change-me-too

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# optional: first admin is created automatically on first start (then delete these two lines)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
